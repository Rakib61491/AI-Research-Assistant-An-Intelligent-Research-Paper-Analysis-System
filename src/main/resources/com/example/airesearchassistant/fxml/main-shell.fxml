<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane fx:id="rootPane"
            prefWidth="1100" prefHeight="700"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airesearchassistant.controller.MainShellController"
            styleClass="main-shell-root">

    <!-- Top Bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar">
            <!-- Current Page Title -->
            <Label fx:id="pageTitleLabel" text="Dashboard" styleClass="page-title" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Global Search Field -->
            <TextField fx:id="globalSearchField"
                       promptText="🔍 Search papers across library..."
                       prefWidth="280"
                       onAction="#handleGlobalSearch"
                       styleClass="search-box" />

            <!-- Ollama Connection Status -->
            <HBox alignment="CENTER" spacing="8" styleClass="ollama-badge">
                <Circle fx:id="ollamaStatusDot" radius="5" style="-fx-fill: #f38ba8;" />
                <Label fx:id="ollamaModelLabel" text="llama3.2" styleClass="ollama-label" />
            </HBox>

            <!-- Theme Toggle Button -->
            <Button fx:id="themeToggleButton"
                    text="☀️ Light Mode"
                    onAction="#handleToggleTheme"
                    styleClass="theme-btn" />
        </HBox>
    </top>

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="230" spacing="4" styleClass="sidebar">
            <!-- App Branding -->
            <VBox spacing="2" styleClass="sidebar-header">
                <Label text="AI Research" styleClass="brand-title" />
                <Label text="Assistant System" styleClass="brand-subtitle" />
            </VBox>

            <Separator styleClass="sidebar-separator" />

            <!-- Navigation Buttons (10 items) -->
            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox spacing="4" styleClass="sidebar-nav-container">
                    <Button fx:id="navDashboard" text="📊  Dashboard" onAction="#handleNavDashboard"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navLibrary" text="📚  Library" onAction="#handleNavLibrary"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navAddPaper" text="➕  Add Paper" onAction="#handleNavAddPaper"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navAssistant" text="🤖  AI Assistant" onAction="#handleNavAssistant"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navComparison" text="⚖️  Comparison" onAction="#handleNavComparison"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navCollections" text="📁  Collections" onAction="#handleNavCollections"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navFavorites" text="⭐  Favorites" onAction="#handleNavFavorites"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navLab" text="🧪  JavaFX Lab" onAction="#handleNavLab"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navSettings" text="⚙️  Settings" onAction="#handleNavSettings"
                            maxWidth="Infinity" styleClass="nav-button" />
                    <Button fx:id="navAbout" text="ℹ️  About" onAction="#handleNavAbout"
                            maxWidth="Infinity" styleClass="nav-button" />
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <!-- Center Content Area (swapped by SceneManager) -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area" />
    </center>

    <!-- Bottom Status Bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="status-bar">
            <Label fx:id="paperCountStatusLabel" text="0 papers" styleClass="status-item" />
            <Label text="·" styleClass="status-separator" />
            <Label fx:id="ollamaStatusLabel" text="Ollama: offline" styleClass="status-item" />
            <Label text="·" styleClass="status-separator" />
            <Label fx:id="dbStatusLabel" text="DB: OK" styleClass="status-item" />

            <Region HBox.hgrow="ALWAYS" />

            <Label text="Java 21 · JavaFX 21" styleClass="status-item-subtle" />
        </HBox>
    </bottom>

</BorderPane>
