<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="host"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airesearchassistant.controller.lab.ResearchLabController"
            styleClass="content-area research-lab">
    <left>
        <VBox spacing="10" prefWidth="255" styleClass="card-section">
            <Label text="Interactive Lab" styleClass="section-header"/>
            <ChoiceBox fx:id="groupChoice" maxWidth="Infinity" styleClass="lab-navigation-choice"/>
            <ListView fx:id="demoList" VBox.vgrow="ALWAYS" styleClass="lab-demo-list"/>
        </VBox>
    </left>
    <center>
        <VBox spacing="12" styleClass="page-container">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4">
                    <Label fx:id="groupLabel" styleClass="muted-text lab-group-label"/>
                    <Label fx:id="demoTitle" styleClass="page-headline"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="demoCounter" styleClass="info-label"/>
            </HBox>
            <Separator/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="page-scroll">
                <content>
                    <VBox fx:id="demoContent" spacing="14" fillWidth="true">
                        <padding><Insets top="4" right="8" bottom="16" left="4"/></padding>
                    </VBox>
                </content>
            </ScrollPane>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="previousButton" text="← Previous" onAction="#showPrevious"/>
                <Button fx:id="nextButton" text="Next →" onAction="#showNext" defaultButton="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
