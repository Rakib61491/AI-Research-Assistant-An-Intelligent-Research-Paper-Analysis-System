<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.airesearchassistant.controller.lab.LabB5Page2Controller"
      alignment="CENTER"
      spacing="20"
      style="-fx-background-color: #1e1e2e; -fx-padding: 40;">

    <Label text="Page 2 (B5 Scene Switch Target)"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #89b4fa;" />

    <Label text="This demonstrates a full Scene swap on the same Stage."
           style="-fx-font-size: 14px; -fx-text-fill: #a6adc8;" />

    <Button fx:id="backButton"
            text="← Back to Lab View"
            onAction="#handleBack"
            style="-fx-background-color: #313244; -fx-text-fill: #cdd6f4; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand;" />

</VBox>
