
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airesearchassistant.AddPaperController"
            prefWidth="1100.0"
            prefHeight="700.0"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="top-bar">
            <padding>
                <Insets top="18" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="Add Research Paper"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Back to Dashboard"
                    onAction="#onCancelClick"
                    styleClass="nav-button"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="15"
              maxWidth="700"
              styleClass="content">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <Label text="Paper Information"
                   styleClass="section-title"/>

            <Label text="Title *"/>
            <TextField fx:id="titleField"
                       promptText="Enter the research paper title"
                       styleClass="search-field"/>

            <Label text="Authors"/>
            <TextField fx:id="authorsField"
                       promptText="Enter author names"
                       styleClass="search-field"/>

            <Label text="Abstract"/>
            <TextArea fx:id="abstractArea"
                      promptText="Enter the paper abstract"
                      prefRowCount="8"
                      wrapText="true"/>

            <Label text="Publication Year"/>
            <TextField fx:id="yearField"
                       promptText="e.g. 2024"
                       styleClass="search-field"
                       maxWidth="180"/>

            <Label fx:id="messageLabel"
                   text=""
                   wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancel"
                        onAction="#onCancelClick"
                        styleClass="nav-button"/>

                <Button text="Save Paper"
                        onAction="#onSaveClick"
                        styleClass="primary-button"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>