<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.airesearchassistant.HelloController"
            prefWidth="1100.0"
            prefHeight="700.0"
            styleClass="root">

    <left>

        <VBox prefWidth="220.0"
              spacing="10.0"
              styleClass="sidebar">

            <padding>
                <Insets top="25.0"
                        right="15.0"
                        bottom="20.0"
                        left="15.0"/>
            </padding>

            <Label text="AI RESEARCH"
                   styleClass="app-title"/>

            <Label text="ASSISTANT"
                   styleClass="app-title"/>

            <Label text="Research Workspace"
                   styleClass="app-subtitle"/>

            <Region prefHeight="15.0"/>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#onDashboardClick"/>

            <Button text="Research Papers"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#onPapersClick"/>

            <Button text="Add Paper"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#onAddPaperClick"/>

            <Button text="Analysis"
                    maxWidth="Infinity"
                    styleClass="nav-button"
                    onAction="#onAnalysisClick"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Exit"
                    maxWidth="Infinity"
                    styleClass="exit-button"
                    onAction="#onExitClick"/>

        </VBox>

    </left>

    <top>

        <HBox spacing="12.0"
              alignment="CENTER_LEFT"
              prefHeight="70.0"
              styleClass="top-bar">

            <padding>
                <Insets top="15.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <Label text="Dashboard"
                   styleClass="page-title"/>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="searchField"
                       promptText="Search papers..."
                       prefWidth="230.0"
                       styleClass="search-field"/>

            <Button text="Search"
                    styleClass="nav-button"
                    onAction="#onSearchClick"/>

            <Button text="+ Add Paper"
                    styleClass="primary-button"
                    onAction="#onAddPaperClick"/>

        </HBox>

    </top>

    <center>

        <ScrollPane fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    styleClass="content">

            <content>

                <VBox spacing="20.0">

                    <padding>
                        <Insets top="30.0"
                                right="30.0"
                                bottom="30.0"
                                left="30.0"/>
                    </padding>

                    <VBox spacing="5.0">

                        <Label text="Welcome back, Researcher"
                               styleClass="welcome-title"/>

                        <Label text="Manage, analyze, and organize your research papers."
                               styleClass="welcome-subtitle"/>

                    </VBox>

                    <HBox spacing="15.0">

                        <VBox spacing="8.0"
                              prefWidth="200.0"
                              HBox.hgrow="ALWAYS"
                              styleClass="stat-card">

                            <Label text="Total Papers"
                                   styleClass="stat-label"/>

                            <Label fx:id="totalPapersLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                        <VBox spacing="8.0"
                              prefWidth="200.0"
                              HBox.hgrow="ALWAYS"
                              styleClass="stat-card">

                            <Label text="Topics"
                                   styleClass="stat-label"/>

                            <Label fx:id="topicsLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                        <VBox spacing="8.0"
                              prefWidth="200.0"
                              HBox.hgrow="ALWAYS"
                              styleClass="stat-card">

                            <Label text="Analyses"
                                   styleClass="stat-label"/>

                            <Label fx:id="analysesLabel"
                                   text="0"
                                   styleClass="stat-value"/>

                        </VBox>

                    </HBox>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Recent Papers"
                               styleClass="section-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="View All"
                                styleClass="nav-button"
                                onAction="#onPapersClick"/>

                    </HBox>

                    <ListView fx:id="recentPapersList"
                              prefHeight="250.0"
                              styleClass="recent-list"/>

                </VBox>

            </content>

        </ScrollPane>

    </center>

    <bottom>

        <HBox alignment="CENTER_LEFT"
              prefHeight="35.0"
              styleClass="status-bar">

            <padding>
                <Insets left="15.0"
                        right="15.0"/>
            </padding>

            <Label fx:id="statusLabel"
                   text="Ready"
                   styleClass="status-text"/>

        </HBox>

    </bottom>

</BorderPane>